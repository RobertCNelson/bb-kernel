# Bluetooth device drivers
#

CONFIG_BT_HCIBTUSB_AUTOSUSPEND=n

# end of Bluetooth device drivers

CONFIG_CFG80211_DEFAULT_PS=n

CONFIG_RFKILL=y

#
# Device Drivers
#

#CONFIG_PCI=n

# end of Bluetooth device drivers

CONFIG_NFC_NCI_SPI=m
CONFIG_NFC_NCI_UART=m

