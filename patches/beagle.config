# Library routines
#

CONFIG_RAID6_PQ_BENCHMARK=n

#
# Default contiguous memory area size:
#

CONFIG_CMA_SIZE_MBYTES=48

#
# Compile-time checks and compiler options
#

CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n

CONFIG_HEADERS_INSTALL=y
CONFIG_DEBUG_SECTION_MISMATCH=y

#
# Generic Kernel Debugging Instruments
#

CONFIG_UBSAN=n

#
# Memory Debugging
#

CONFIG_PAGE_OWNER=y

# end of Memory Debugging

CONFIG_DEBUG_SHIRQ=y

#
# Debug Oops, Lockups and Hangs
#

CONFIG_WQ_CPU_INTENSIVE_REPORT=y

#
# RCU Debugging
#

CONFIG_RCU_CPU_STALL_CPUTIME=y

# end of RCU Debugging

CONFIG_BOOTTIME_TRACING=y
CONFIG_FUNCTION_PROFILER=y
CONFIG_SCHED_TRACER=y
CONFIG_HWLAT_TRACER=y
CONFIG_OSNOISE_TRACER=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_STRICT_DEVMEM=n

#
# arm Debugging
#

CONFIG_CORESIGHT=n

#
# Kernel Testing and Coverage
#

CONFIG_FUNCTION_ERROR_INJECTION=y
CONFIG_RUNTIME_TESTING_MENU=n
CONFIG_MEMTEST=y

###BUGS...

#debian Trixie has fubared lz4/lz4c, back to xz for stabilty...
#  LZ4     arch/arm/boot/compressed/piggy_data
#Error : stdout won't be used ! Do you want multiple input files (-m) ?
#make[3]: *** [arch/arm/boot/compressed/Makefile:156: arch/arm/boot/compressed/piggy_data] Error 1

CONFIG_KERNEL_LZO=n
CONFIG_KERNEL_LZ4=n
CONFIG_KERNEL_XZ=y

#v6.19-rc1

CONFIG_RTW89_8852AU=m
CONFIG_RTW89_8852CU=m
CONFIG_SENSORS_MAX17616=m
CONFIG_SENSORS_MP2925=m
CONFIG_SENSORS_MP9945=m
CONFIG_SENSORS_TSC1641=m
CONFIG_MAX14001=m
CONFIG_AD5446_SPI=m
CONFIG_AD5446_I2C=m
CONFIG_INV_ICM45600_I2C=m
CONFIG_INV_ICM45600_SPI=m
CONFIG_SMI330_I2C=m
CONFIG_SMI330_SPI=m
CONFIG_ADP810=m

#CC33XX
CONFIG_CC33XX=m
CONFIG_CC33XX_SPI=n
CONFIG_CC33XX_SDIO=m

CONFIG_BT_TI_UART=m

###
