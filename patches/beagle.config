###
# sed -i '/^CONFIG/ s/^/#/' ./patches/beagle.config
###

#
# Timers subsystem
#

CONFIG_NO_HZ_COMMON=y
CONFIG_NO_HZ_IDLE=y
CONFIG_CONTEXT_TRACKING_USER_FORCE=y

#
# BPF subsystem
#

CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_PRELOAD=y
CONFIG_BPF_PRELOAD_UMD=y

# end of BPF subsystem

CONFIG_PREEMPT=y

#
# CPU/Task time and stats accounting
#

CONFIG_PSI_DEFAULT_DISABLED=y

# end of RCU Subsystem

CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_IKHEADERS=m
CONFIG_PRINTK_INDEX=y

# end of Scheduler features

#CONFIG_MEMCG_V1=y
#CONFIG_CGROUP_DMEM=y
CONFIG_BOOT_CONFIG=y
CONFIG_KALLSYMS_ALL=y

#
# Kexec and crash features
#

CONFIG_KEXEC=n
CONFIG_CRASH_DUMP=n

#
# CPU Core family selection
#

CONFIG_ARCH_VIRT=n
CONFIG_ARCH_ASPEED=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_HIGHBANK=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MMP=n
CONFIG_ARCH_MVEBU=n

#
# TI OMAP/AM/DM/DRA Family
#

CONFIG_ARCH_OMAP3=n
CONFIG_ARCH_OMAP4=n
CONFIG_SOC_OMAP5=n

CONFIG_SOC_AM33XX=y

CONFIG_SOC_AM43XX=n
CONFIG_SOC_DRA7XX=n

# end of TI OMAP/AM/DM/DRA Family

CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_STM32=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_TEGRA=n
CONFIG_ARCH_VEXPRESS=n
CONFIG_ARCH_WM8850=n

#
# Processor Features
#

#CONFIG_CACHE_L2X0=n
CONFIG_PL310_ERRATA_769419=n
#Cortex-A9 720789, 754322, 775420
CONFIG_ARM_ERRATA_720789=n
CONFIG_ARM_ERRATA_754322=n
CONFIG_ARM_ERRATA_775420=n

#
# Kernel Features
#

CONFIG_SMP=n
CONFIG_THUMB2_KERNEL=y
CONFIG_XEN=n

#
# Boot options
#

CONFIG_ATAGS=n
CONFIG_ARM_APPENDED_DTB=n

#
# CPU Frequency scaling
#

CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y

#
# CPU frequency scaling drivers
#

CONFIG_CPUFREQ_DT=y
CONFIG_ARM_OMAP2PLUS_CPUFREQ=n

#
# CPU Idle
#

CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_LADDER=y
CONFIG_CPU_IDLE_GOV_MENU=y

#
# ARM CPU Idle Drivers
#

CONFIG_ARM_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y

#
# Power management options
#

CONFIG_PM_AUTOSLEEP=y
CONFIG_PM_WAKELOCKS=y

# end of General architecture-dependent options

CONFIG_MODULE_SIG=n
CONFIG_MODULE_DECOMPRESS=n
CONFIG_BLK_CGROUP_IOPRIO=y

#
# Memory Management options
#

CONFIG_ZSWAP_ZPOOL_DEFAULT_ZBUD=y
CONFIG_ZSMALLOC=m

# end of Slab allocator options

CONFIG_IDLE_PAGE_TRACKING=y
CONFIG_ANON_VMA_NAME=y

#
# Data Access Monitoring
#

#CONFIG_DAMON=n

#
# Networking options
#

CONFIG_XDP_SOCKETS_DIAG=n
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_IP_PNP_BOOTP=y
CONFIG_IP_PNP_RARP=y
CONFIG_NET_IP_TUNNEL=y
CONFIG_NET_UDP_TUNNEL=y

