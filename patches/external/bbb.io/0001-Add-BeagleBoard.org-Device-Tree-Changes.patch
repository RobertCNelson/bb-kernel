+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * DT Overlay for SPI6 CS0 and CS1 on the BeagleBoneAI64.
+ * Pins:
+ * - CS0: P9_17a (SPI6_CS0)
+ * - CS1: P9_23 (SPI6_CS1)
+ * - CLK: P9_22a (SPI6_CLK)
+ * - MOSI: P9_21a (SPI6_D0)
+ * - MISO: P9_18a (SPI6_D1)
+ *
+ * Copyright (C) 2023 Texas Instruments Incorporated - https://www.ti.com/
+ */
+
