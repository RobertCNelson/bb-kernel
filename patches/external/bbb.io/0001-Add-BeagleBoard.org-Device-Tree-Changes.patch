+    #size-cells = <0>;
+    pinctrl-names = "default";
+    pinctrl-0 = <&mcspi6_pins>;
+    ti,spi-num-cs = <2>; /* Support two chip selects */
+    ti,pindir-d0-out-d1-in;
+    status = "okay";
