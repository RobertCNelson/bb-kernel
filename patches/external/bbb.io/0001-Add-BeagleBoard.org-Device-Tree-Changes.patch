index 000000000000..b90512e24ea0
--- /dev/null
+++ b/arch/arm64/boot/dts/ti/k3-am625-sancloud-bbe-2.dts
@@ -0,0 +1,1119 @@
+// SPDX-License-Identifier: GPL-2.0
