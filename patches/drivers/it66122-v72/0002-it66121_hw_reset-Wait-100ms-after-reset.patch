From ac48864c2f82ec798d335a11c2c17b8dd8821029 Mon Sep 17 00:00:00 2001
From: OpenEmbedded <oe.patch@oe>
Date: Fri, 14 Aug 2026 14:56:21 +0200
Subject: [PATCH 2/2] it66121_hw_reset: Wait 100ms after reset

Otherwise I2c does not respond

Signed-off-by: OpenEmbedded <oe.patch@oe>
---
 drivers/gpu/drm/bridge/ite-it66121.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/gpu/drm/bridge/ite-it66121.c b/drivers/gpu/drm/bridge/ite-it66121.c
index 86fd29ad7e1c..29dc2a480cf1 100644
--- a/drivers/gpu/drm/bridge/ite-it66121.c
+++ b/drivers/gpu/drm/bridge/ite-it66121.c
@@ -356,6 +356,7 @@ static void it66121_hw_reset(struct it66121_ctx *ctx)
 	gpiod_set_value(ctx->gpio_reset, 1);
 	msleep(20);
 	gpiod_set_value(ctx->gpio_reset, 0);
+	msleep(100);
 }
 
 static inline int it66121_preamble_ddc(struct it66121_ctx *ctx)
-- 
2.55.0

