From 5c697a146d658b6a54554f17ef9bf39c7c48872a Mon Sep 17 00:00:00 2001
From: Robert Nelson <robertcnelson@gmail.com>
Date: Sat, 25 Apr 2026 09:10:32 -0500
Subject: [PATCH 7/7] fixes: cc33xx: remove

Signed-off-by: Robert Nelson <robertcnelson@gmail.com>
---
 drivers/net/wireless/ti/cc33xx/main.c | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/drivers/net/wireless/ti/cc33xx/main.c b/drivers/net/wireless/ti/cc33xx/main.c
index 6f38a8488118..342915695cf0 100644
--- a/drivers/net/wireless/ti/cc33xx/main.c
+++ b/drivers/net/wireless/ti/cc33xx/main.c
@@ -2038,7 +2038,7 @@ static void cc33xx_turn_off(struct cc33xx *cc)
 	mutex_unlock(&cc->mutex);
 }
 
-static inline void cc33xx_op_stop(struct ieee80211_hw *hw)
+static inline void cc33xx_op_stop(struct ieee80211_hw *hw, bool suspend)
 {
 	cc33xx_debug(DEBUG_MAC80211, "mac80211 stop");
 }
@@ -5940,7 +5940,7 @@ static int cc33xx_probe(struct platform_device *pdev)
 	return ret;
 }
 
-static int cc33xx_remove(struct platform_device *pdev)
+void cc33xx_remove(struct platform_device *pdev)
 {
 	struct cc33xx_platdev_data *pdev_data = dev_get_platdata(&pdev->dev);
 	struct cc33xx *cc = platform_get_drvdata(pdev);
@@ -5968,7 +5968,6 @@ static int cc33xx_remove(struct platform_device *pdev)
 
 out:
 	cc33xx_free_hw(cc);
-	return 0;
 }
 
 static const struct platform_device_id cc33xx_id_table[] = {
@@ -5979,7 +5978,7 @@ MODULE_DEVICE_TABLE(platform, cc33xx_id_table);
 
 static struct platform_driver cc33xx_driver = {
 	.probe		= cc33xx_probe,
-	.remove		= cc33xx_remove,
+	.remove_new	= cc33xx_remove,
 	.id_table	= cc33xx_id_table,
 	.driver = {
 		.name	= "cc33xx_driver",
-- 
2.53.0

