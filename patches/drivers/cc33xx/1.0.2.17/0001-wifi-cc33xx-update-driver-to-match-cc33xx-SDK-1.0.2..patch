+static ssize_t ble_enable_show(struct device *dev,
+				  struct device_attribute *attr,
+				  char *buf)
+{
+	struct cc33xx *cc = dev_get_drvdata(dev);
+	ssize_t len;
+
+	mutex_lock(&cc->mutex);
+	len = sysfs_emit(buf, "%d\n", cc->ble_enable);
+	mutex_unlock(&cc->mutex);
+
+	return len;
+}
