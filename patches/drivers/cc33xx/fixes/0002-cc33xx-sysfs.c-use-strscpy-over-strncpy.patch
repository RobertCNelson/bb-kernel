From e662b72b0a595ef9555667db0a6dcb832d3ecc5d Mon Sep 17 00:00:00 2001
From: Robert Nelson <robertcnelson@gmail.com>
Date: Fri, 23 Oct 2026 22:11:13 -0500
Subject: [PATCH 2/2] cc33xx: sysfs.c use strscpy over strncpy

Signed-off-by: Robert Nelson <robertcnelson@gmail.com>
---
 drivers/net/wireless/ti/cc33xx/sysfs.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/net/wireless/ti/cc33xx/sysfs.c b/drivers/net/wireless/ti/cc33xx/sysfs.c
index d9461d671a2c..1197ede2c3a5 100644
--- a/drivers/net/wireless/ti/cc33xx/sysfs.c
+++ b/drivers/net/wireless/ti/cc33xx/sysfs.c
@@ -139,7 +139,7 @@ static ssize_t regdomain_txControl_param_store(struct device *dev,
 		return ret;
 	}
 
-	strncpy(buffer, buf, count);
+	strscpy(buffer, buf, count);
 	if(-EFAULT == ret){
 		cc33xx_warning("error in regdomain and tx control params set: %d", ret);
 		kfree(buffer);
-- 
2.55.0

