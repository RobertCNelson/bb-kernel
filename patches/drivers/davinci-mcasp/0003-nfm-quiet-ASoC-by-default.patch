From e22390d91e9df74bc921857301aec86745aec402 Mon Sep 17 00:00:00 2001
From: Robert Nelson <robertcnelson@gmail.com>
Date: Tue, 25 Aug 2026 14:32:03 -0500
Subject: [PATCH 3/3] [nfm] quiet ASoC by default

Signed-off-by: Robert Nelson <robertcnelson@gmail.com>
---
 sound/soc/soc-card.c      | 2 +-
 sound/soc/soc-component.c | 4 ++--
 sound/soc/soc-core.c      | 2 +-
 sound/soc/soc-dai.c       | 2 +-
 sound/soc/soc-link.c      | 2 +-
 sound/soc/soc-pcm.c       | 2 +-
 6 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/sound/soc/soc-card.c b/sound/soc/soc-card.c
index 8e9546fe7428..e417b2778e53 100644
--- a/sound/soc/soc-card.c
+++ b/sound/soc/soc-card.c
@@ -21,7 +21,7 @@ static inline int _soc_card_ret(struct snd_soc_card *card,
 	case 0:
 		break;
 	default:
-		dev_err(card->dev,
+		dev_dbg(card->dev,
 			"ASoC: error at %s on %s: %d\n",
 			func, card->name, ret);
 	}
diff --git a/sound/soc/soc-component.c b/sound/soc/soc-component.c
index b3d7bb91e294..36de816d7680 100644
--- a/sound/soc/soc-component.c
+++ b/sound/soc/soc-component.c
@@ -29,11 +29,11 @@ static inline int _soc_component_ret(struct snd_soc_component *component,
 		break;
 	default:
 		if (reg == -1)
-			dev_err(component->dev,
+			dev_dbg(component->dev,
 				"ASoC: error at %s on %s: %d\n",
 				func, component->name, ret);
 		else
-			dev_err(component->dev,
+			dev_dbg(component->dev,
 				"ASoC: error at %s on %s for register: [0x%08x] %d\n",
 				func, component->name, reg, ret);
 	}
diff --git a/sound/soc/soc-core.c b/sound/soc/soc-core.c
index 5097b287b889..b6b5627982c5 100644
--- a/sound/soc/soc-core.c
+++ b/sound/soc/soc-core.c
@@ -2617,7 +2617,7 @@ static inline char *fmt_multiple_name(struct device *dev,
 		struct snd_soc_dai_driver *dai_drv)
 {
 	if (dai_drv->name == NULL) {
-		dev_err(dev,
+		dev_dbg(dev,
 			"ASoC: error - multiple DAI %s registered with no name\n",
 			dev_name(dev));
 		return NULL;
diff --git a/sound/soc/soc-dai.c b/sound/soc/soc-dai.c
index ad106087dd4b..aaa64fe5e34e 100644
--- a/sound/soc/soc-dai.c
+++ b/sound/soc/soc-dai.c
@@ -24,7 +24,7 @@ static inline int _soc_dai_ret(const struct snd_soc_dai *dai,
 	case -ENOTSUPP:
 		break;
 	default:
-		dev_err(dai->dev,
+		dev_dbg(dai->dev,
 			"ASoC: error at %s on %s: %d\n",
 			func, dai->name, ret);
 	}
diff --git a/sound/soc/soc-link.c b/sound/soc/soc-link.c
index fee4022708bc..ba5e523dd231 100644
--- a/sound/soc/soc-link.c
+++ b/sound/soc/soc-link.c
@@ -22,7 +22,7 @@ static inline int _soc_link_ret(struct snd_soc_pcm_runtime *rtd,
 	case -ENOTSUPP:
 		break;
 	default:
-		dev_err(rtd->dev,
+		dev_dbg(rtd->dev,
 			"ASoC: error at %s on %s: %d\n",
 			func, rtd->dai_link->name, ret);
 	}
diff --git a/sound/soc/soc-pcm.c b/sound/soc/soc-pcm.c
index 628322790c87..875dd2ab7ff8 100644
--- a/sound/soc/soc-pcm.c
+++ b/sound/soc/soc-pcm.c
@@ -40,7 +40,7 @@ static inline int _soc_pcm_ret(struct snd_soc_pcm_runtime *rtd,
 	case -ENOTSUPP:
 		break;
 	default:
-		dev_err(rtd->dev,
+		dev_dbg(rtd->dev,
 			"ASoC: error at %s on %s: %d\n",
 			func, rtd->dai_link->name, ret);
 	}
-- 
2.55.0

