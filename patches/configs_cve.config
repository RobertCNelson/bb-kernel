
#
# By Default we don't use ACPI, just disable ACPI_APEI_EINJ for CVE-2016-3695
#

CONFIG_ACPI_APEI_EINJ=n

#
# These are set by default, but documented for CVE-2021-20194
#

CONFIG_BPF_SYSCALL=y
CONFIG_BPF=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_HARDENED_USERCOPY=y

#
# These are disabled (and removed), but documented for CVE-2022-1247
#

CONFIG_AX25=n
CONFIG_NETROM=n
CONFIG_ROSE=n

#
# These are disabled (and removed), but documented for CVE-2023-6610
#

CONFIG_CIFS_DEBUG2=n